{
  "name": "Layer Lens — Live2D PSDチェッカー",
  "short_name": "Layer Lens",
  "description": "Live2D用PSD/CLIPの検品ツール。マスク・クリッピング・命名・同名レイヤーなどをブラウザ内だけでチェックします。",
  "lang": "ja",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0e0d18",
  "theme_color": "#7158ff",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/vnd.adobe.photoshop": [".psd"],
        "application/x-clip-studio": [".clip"]
      }
    }
  ]
}
